<UserControl x:Class="FloatingB.Features.FloatingControl.Views.FloatingControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="130"
             Height="150">

	<Canvas Width="130" Height="150">

		<!-- Half-circle menu, hidden at the start -->
		<Canvas x:Name="Menu" Width="130" Height="150"
		        Visibility="Collapsed" Opacity="0"
		        RenderTransformOrigin="0.77,0.5">

			<Canvas.RenderTransform>
				<ScaleTransform x:Name="MenuScale" ScaleX="0.3" ScaleY="0.3"/>
			</Canvas.RenderTransform>

			<Path Fill="#DDF0FB" Data="M 100,5 A 70,70 0 0 0 100,145 Z">
				<Path.Effect>
					<DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="8" ShadowDepth="1"/>
				</Path.Effect>
			</Path>

			<!-- Top: Screenshot -->
			<Border Width="32" Height="32" CornerRadius="16" Background="White"
			        Canvas.Left="61" Canvas.Top="20" Cursor="Hand"  MouseLeftButtonDown="Screenshot_Click"	>
				<TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="15"
				           Foreground="#17627D" HorizontalAlignment="Center"
				           VerticalAlignment="Center"/>
			</Border>

			<!-- Middle: Power -->
			<Border Width="32" Height="32" CornerRadius="16" Background="White"
			        Canvas.Left="39" Canvas.Top="59" Cursor="Hand" MouseLeftButtonDown="Power_Click">
				<TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="15"
				           Foreground="#E5484D" HorizontalAlignment="Center"
				           VerticalAlignment="Center"/>
			</Border>

			<!-- Bottom: Lock -->
			<Border Width="32" Height="32" CornerRadius="16" Background="White"
			        Canvas.Left="61" Canvas.Top="98" Cursor="Hand" MouseLeftButtonDown="Lock_Click">
				<TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="15"
				           Foreground="#17627D" HorizontalAlignment="Center"
				           VerticalAlignment="Center"/>
			</Border>
		</Canvas>

		<!-- Your light blue round button with the white circle -->
		<Border x:Name="MainBody"
		        Width="50" Height="50"
		        CornerRadius="25"
		        Background="#7CC8F2"
		        Canvas.Left="75" Canvas.Top="50"
		        Cursor="Hand">

			<Border.Effect>
				<DropShadowEffect Color="Black" Opacity="0.25" BlurRadius="8" ShadowDepth="2"/>
			</Border.Effect>

			<Ellipse x:Name="OmegaCircle"
			         Width="22" Height="22"
			         Stroke="White" StrokeThickness="3"
			         HorizontalAlignment="Center"
			         VerticalAlignment="Center"/>
		</Border>

	</Canvas>
</UserControl>