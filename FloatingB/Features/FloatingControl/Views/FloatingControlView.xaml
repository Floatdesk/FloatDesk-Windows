<UserControl x:Class="FloatingB.Features.FloatingControl.Views.FloatingControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<UserControl.Resources>

		<SolidColorBrush x:Key="BrandBrush" Color="#17627D"/>
		<SolidColorBrush x:Key="RingBrush" Color="#0F3A4A"/>

		<!-- Round white action button; fills with its accent colour (Tag) on hover -->
		<Style x:Key="MenuButtonStyle" TargetType="Button">
			<Setter Property="Width" Value="42"/>
			<Setter Property="Height" Value="42"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Focusable" Value="False"/>
			<Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
			<!-- The icon inherits Foreground from the Button itself -->
			<Setter Property="Foreground" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Grid>
							<Ellipse x:Name="Bg" Fill="White"/>
							<ContentPresenter HorizontalAlignment="Center"
							                  VerticalAlignment="Center"/>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bg" Property="Fill"
								        Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Foreground" Value="White"/>
				</Trigger>
			</Style.Triggers>
		</Style>

	</UserControl.Resources>

	<!--
		Drawn as if docked to the RIGHT edge of the screen: the edge is
		x = 128. SetEdge() mirrors or rotates this for the other edges.
	-->
	<Canvas x:Name="Root" Width="128" Height="188">

		<!-- Ring menu around the main button, hidden at the start -->
		<Canvas x:Name="Menu" Width="128" Height="188"
		        Visibility="Collapsed" Opacity="0">

			<Canvas.RenderTransform>
				<ScaleTransform x:Name="MenuScale" ScaleX="0.4" ScaleY="0.4"/>
			</Canvas.RenderTransform>

			<!-- Thick arc with round ends that sits behind the buttons -->
			<Path x:Name="Ring"
			      Stroke="{StaticResource RingBrush}"
			      StrokeThickness="54"
			      StrokeStartLineCap="Round"
			      StrokeEndLineCap="Round"/>

			<Canvas x:Name="ButtonLayer"/>
		</Canvas>

		<!-- Main floating button. At rest it is pushed half past the edge. -->
		<Grid x:Name="MainBody"
		      Width="56" Height="56"
		      Canvas.Left="66" Canvas.Top="66"
		      Cursor="Hand"
		      RenderTransformOrigin="0.5,0.5">

			<Grid.RenderTransform>
				<TransformGroup>
					<ScaleTransform x:Name="MainScale" ScaleX="1" ScaleY="1"/>
					<TranslateTransform x:Name="PeekShift"/>
				</TransformGroup>
			</Grid.RenderTransform>

			<Grid.Triggers>
				<EventTrigger RoutedEvent="MouseEnter">
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleX"
							                 To="1.06" Duration="0:0:0.15"/>
							<DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleY"
							                 To="1.06" Duration="0:0:0.15"/>
						</Storyboard>
					</BeginStoryboard>
				</EventTrigger>
				<EventTrigger RoutedEvent="MouseLeave">
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleX"
							                 To="1" Duration="0:0:0.2"/>
							<DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleY"
							                 To="1" Duration="0:0:0.2"/>
						</Storyboard>
					</BeginStoryboard>
				</EventTrigger>
			</Grid.Triggers>

			<Ellipse Fill="{StaticResource BrandBrush}" Stroke="White" StrokeThickness="2">
				<Ellipse.Effect>
					<DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="10" ShadowDepth="2" Direction="270"/>
				</Ellipse.Effect>
			</Ellipse>

			<!-- Counter-transform so the icon stays upright on every edge -->
			<Grid x:Name="IconOrient" IsHitTestVisible="False"
			      HorizontalAlignment="Center" VerticalAlignment="Center">

				<!-- Icon: the chosen icon when closed, ✕ when open -->
				<Grid x:Name="IconHost" RenderTransformOrigin="0.5,0.5">
					<Grid.RenderTransform>
						<RotateTransform x:Name="IconRotate" Angle="0"/>
					</Grid.RenderTransform>

					<TextBlock x:Name="MainIcon"
					           Text="{Binding Icon}"
					           FontFamily="{Binding IconFont}"
					           FontSize="26"
					           Foreground="White"
					           HorizontalAlignment="Center" VerticalAlignment="Center"/>

					<TextBlock x:Name="CloseIcon"
					           Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="20"
					           Foreground="White" Opacity="0"
					           HorizontalAlignment="Center" VerticalAlignment="Center"/>
				</Grid>
			</Grid>
		</Grid>

	</Canvas>
</UserControl>
