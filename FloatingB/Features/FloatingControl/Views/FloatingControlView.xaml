<UserControl x:Class="FloatingB.Features.FloatingControl.Views.FloatingControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="100"
             Height="64">

    <Grid>

        <!-- Main rounded rectangular body -->
        <Border x:Name="MainBody"
                Width="82"
                Height="50"
                HorizontalAlignment="left"
                VerticalAlignment="Center"
                CornerRadius="10"
                Background="#17627D"
                
               >

        </Border>


        <!-- Front circular Ω control -->
        <Border x:Name="OmegaCircle"
                Width="50"
                Height="50"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                CornerRadius="29"
                Background="#17627D"
               
                Panel.ZIndex="10">

            

        </Border>

    </Grid>

</UserControl>